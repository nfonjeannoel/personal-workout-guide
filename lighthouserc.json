{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in|started server|Local:",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/exercises",
        "http://127.0.0.1:3000/exercises/machine-chest-press",
        "http://127.0.0.1:3000/my-training"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
